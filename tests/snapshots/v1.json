{
  "AssessmentEnvelope": {
    "$defs": {
      "Finding": {
        "additionalProperties": false,
        "properties": {
          "benchmark": {
            "title": "Benchmark",
            "type": "string"
          },
          "benchmark_version": {
            "title": "Benchmark Version",
            "type": "string"
          },
          "collected_at": {
            "format": "date-time",
            "title": "Collected At",
            "type": "string"
          },
          "control_id": {
            "title": "Control Id",
            "type": "string"
          },
          "evidence": {
            "title": "Evidence",
            "type": "string"
          },
          "level": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          },
          "remediation": {
            "title": "Remediation",
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not_assessed",
              "not_applicable"
            ],
            "title": "Result",
            "type": "string"
          },
          "scored": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scored"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "control_id",
          "title",
          "benchmark",
          "benchmark_version",
          "result",
          "level",
          "scored",
          "evidence",
          "remediation",
          "collected_at"
        ],
        "title": "Finding",
        "type": "object"
      },
      "Summary": {
        "additionalProperties": false,
        "properties": {
          "compliance_pct": {
            "anyOf": [
              {
                "maximum": 100,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "None = nada aplicável foi avaliado",
            "title": "Compliance Pct"
          },
          "failed": {
            "minimum": 0,
            "title": "Failed",
            "type": "integer"
          },
          "not_applicable": {
            "minimum": 0,
            "title": "Not Applicable",
            "type": "integer"
          },
          "not_assessed": {
            "minimum": 0,
            "title": "Not Assessed",
            "type": "integer"
          },
          "passed": {
            "minimum": 0,
            "title": "Passed",
            "type": "integer"
          }
        },
        "required": [
          "passed",
          "failed",
          "not_assessed",
          "not_applicable",
          "compliance_pct"
        ],
        "title": "Summary",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "assessed_at": {
        "format": "date-time",
        "title": "Assessed At",
        "type": "string"
      },
      "assessed_ip": {
        "title": "Assessed Ip",
        "type": "string"
      },
      "assessment_id": {
        "format": "uuid",
        "title": "Assessment Id",
        "type": "string"
      },
      "findings": {
        "anyOf": [
          {
            "items": {
              "$ref": "#/$defs/Finding"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "description": "Presente na resposta da própria avaliação; depois, só se 'guardar achados' estiver ligado e dentro da retenção. null sempre acompanha findings_omitted_reason.",
        "title": "Findings"
      },
      "findings_omitted_reason": {
        "anyOf": [
          {
            "enum": [
              "not_stored",
              "retention_expired"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "not_stored: 'guardar achados' desligado (inclusive em repetição por Idempotency-Key); retention_expired: guardados, mas já apagados pela retenção",
        "title": "Findings Omitted Reason"
      },
      "source": {
        "enum": [
          "console",
          "api"
        ],
        "title": "Source",
        "type": "string"
      },
      "summary": {
        "$ref": "#/$defs/Summary"
      },
      "target_id": {
        "title": "Target Id",
        "type": "integer"
      },
      "target_kind": {
        "const": "linux_host",
        "default": "linux_host",
        "title": "Target Kind",
        "type": "string"
      }
    },
    "required": [
      "assessment_id",
      "target_id",
      "assessed_ip",
      "assessed_at",
      "source",
      "summary",
      "findings",
      "findings_omitted_reason"
    ],
    "title": "AssessmentEnvelope",
    "type": "object"
  },
  "AssessmentListItem": {
    "$defs": {
      "Summary": {
        "additionalProperties": false,
        "properties": {
          "compliance_pct": {
            "anyOf": [
              {
                "maximum": 100,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "None = nada aplicável foi avaliado",
            "title": "Compliance Pct"
          },
          "failed": {
            "minimum": 0,
            "title": "Failed",
            "type": "integer"
          },
          "not_applicable": {
            "minimum": 0,
            "title": "Not Applicable",
            "type": "integer"
          },
          "not_assessed": {
            "minimum": 0,
            "title": "Not Assessed",
            "type": "integer"
          },
          "passed": {
            "minimum": 0,
            "title": "Passed",
            "type": "integer"
          }
        },
        "required": [
          "passed",
          "failed",
          "not_assessed",
          "not_applicable",
          "compliance_pct"
        ],
        "title": "Summary",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "assessed_at": {
        "format": "date-time",
        "title": "Assessed At",
        "type": "string"
      },
      "assessed_ip": {
        "title": "Assessed Ip",
        "type": "string"
      },
      "assessment_id": {
        "format": "uuid",
        "title": "Assessment Id",
        "type": "string"
      },
      "findings_stored": {
        "title": "Findings Stored",
        "type": "boolean"
      },
      "source": {
        "enum": [
          "console",
          "api"
        ],
        "title": "Source",
        "type": "string"
      },
      "summary": {
        "$ref": "#/$defs/Summary"
      },
      "target_id": {
        "title": "Target Id",
        "type": "integer"
      }
    },
    "required": [
      "assessment_id",
      "target_id",
      "assessed_ip",
      "assessed_at",
      "source",
      "summary",
      "findings_stored"
    ],
    "title": "AssessmentListItem",
    "type": "object"
  },
  "AssessmentRequest": {
    "$defs": {
      "SSHCredentials": {
        "additionalProperties": false,
        "description": "SOMENTE ENTRADA. Usadas apenas durante a avaliação: nunca aparecem em\nresposta, log, persistência ou webhook. Nenhum modelo de saída do v1\nreferencia este tipo (garantido por teste) e os segredos são excluídos\nde qualquer serialização (`model_dump`/`model_dump_json`).",
        "properties": {
          "auth_method": {
            "enum": [
              "key",
              "password"
            ],
            "title": "Auth Method",
            "type": "string"
          },
          "password": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Password",
            "writeOnly": true
          },
          "port": {
            "default": 22,
            "maximum": 65535,
            "minimum": 1,
            "title": "Port",
            "type": "integer"
          },
          "private_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Private Key",
            "writeOnly": true
          },
          "username": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "auth_method"
        ],
        "title": "SSHCredentials",
        "type": "object",
        "writeOnly": true
      }
    },
    "additionalProperties": false,
    "properties": {
      "ip": {
        "anyOf": [
          {
            "format": "ipvanyaddress",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "IP dentro do alvo (CIDR) e presente na última descoberta; omitido = primeiro descoberto",
        "title": "Ip"
      },
      "ssh": {
        "$ref": "#/$defs/SSHCredentials"
      }
    },
    "required": [
      "ssh"
    ],
    "title": "AssessmentRequest",
    "type": "object"
  },
  "DiscoveryHost": {
    "additionalProperties": false,
    "properties": {
      "classification": {
        "enum": [
          "windows",
          "linux",
          "docker",
          "waf",
          "firewall",
          "vmware",
          "unknown"
        ],
        "title": "Classification",
        "type": "string"
      },
      "confidence": {
        "maximum": 1,
        "minimum": 0,
        "title": "Confidence",
        "type": "number"
      },
      "ip": {
        "title": "Ip",
        "type": "string"
      },
      "scanned_at": {
        "format": "date-time",
        "title": "Scanned At",
        "type": "string"
      }
    },
    "required": [
      "ip",
      "classification",
      "confidence",
      "scanned_at"
    ],
    "title": "DiscoveryHost",
    "type": "object"
  },
  "ErrorResponse": {
    "$defs": {
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/$defs/ErrorCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorCode": {
        "description": "Códigos estáveis de erro. Extensível: valores novos podem surgir.",
        "enum": [
          "unauthorized",
          "forbidden_scope",
          "not_found",
          "validation_error",
          "rate_limited",
          "idempotency_mismatch",
          "idempotency_in_progress",
          "license_required",
          "license_expired",
          "license_revoked",
          "target_not_discovered",
          "ip_not_in_target",
          "findings_not_stored",
          "ssh_auth_failed",
          "target_unreachable",
          "assessment_timeout",
          "upstream_error",
          "internal_error"
        ],
        "title": "ErrorCode",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "error": {
        "$ref": "#/$defs/ErrorBody"
      }
    },
    "required": [
      "error"
    ],
    "title": "ErrorResponse",
    "type": "object"
  },
  "ReportRequest": {
    "additionalProperties": false,
    "description": "Gera o PDF (resposta binária application/pdf) de uma avaliação já\nfeita. Só funciona com 'guardar achados' ligado e os achados ainda dentro\nda retenção; senão ErrorCode.findings_not_stored. Com a opção desligada,\nos achados não são persistidos nem temporariamente.",
    "properties": {
      "assessment_id": {
        "format": "uuid",
        "title": "Assessment Id",
        "type": "string"
      },
      "kind": {
        "enum": [
          "executive",
          "technical"
        ],
        "title": "Kind",
        "type": "string"
      }
    },
    "required": [
      "assessment_id",
      "kind"
    ],
    "title": "ReportRequest",
    "type": "object"
  },
  "Target": {
    "additionalProperties": false,
    "properties": {
      "address": {
        "title": "Address",
        "type": "string"
      },
      "created_at": {
        "format": "date-time",
        "title": "Created At",
        "type": "string"
      },
      "id": {
        "title": "Id",
        "type": "integer"
      },
      "label": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Label"
      },
      "tags": {
        "items": {
          "type": "string"
        },
        "title": "Tags",
        "type": "array"
      }
    },
    "required": [
      "id",
      "address",
      "label",
      "tags",
      "created_at"
    ],
    "title": "Target",
    "type": "object"
  },
  "TargetCreate": {
    "additionalProperties": false,
    "properties": {
      "address": {
        "description": "IP único (\"10.0.0.5\") ou CIDR (\"10.0.0.0/24\")",
        "title": "Address",
        "type": "string"
      },
      "label": {
        "anyOf": [
          {
            "maxLength": 200,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Label"
      },
      "tags": {
        "items": {
          "type": "string"
        },
        "maxItems": 50,
        "title": "Tags",
        "type": "array"
      }
    },
    "required": [
      "address"
    ],
    "title": "TargetCreate",
    "type": "object"
  },
  "WebhookEvent": {
    "$defs": {
      "AssessmentCompletedData": {
        "additionalProperties": false,
        "description": "Só o resumo — nunca achados, evidência ou credenciais.",
        "properties": {
          "source": {
            "enum": [
              "console",
              "api"
            ],
            "title": "Source",
            "type": "string"
          },
          "summary": {
            "$ref": "#/$defs/Summary"
          },
          "target": {
            "discriminator": {
              "mapping": {
                "docker_container": "#/$defs/ContainerRef",
                "linux_host": "#/$defs/HostRef"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/HostRef"
              },
              {
                "$ref": "#/$defs/ContainerRef"
              }
            ],
            "title": "Target"
          }
        },
        "required": [
          "source",
          "target",
          "summary"
        ],
        "title": "AssessmentCompletedData",
        "type": "object"
      },
      "ContainerRef": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "docker_container",
            "default": "docker_container",
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "ContainerRef",
        "type": "object"
      },
      "HostRef": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "title": "Address",
            "type": "string"
          },
          "assessed_ip": {
            "title": "Assessed Ip",
            "type": "string"
          },
          "kind": {
            "const": "linux_host",
            "default": "linux_host",
            "title": "Kind",
            "type": "string"
          },
          "target_id": {
            "title": "Target Id",
            "type": "integer"
          }
        },
        "required": [
          "target_id",
          "address",
          "assessed_ip"
        ],
        "title": "HostRef",
        "type": "object"
      },
      "Summary": {
        "additionalProperties": false,
        "properties": {
          "compliance_pct": {
            "anyOf": [
              {
                "maximum": 100,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "None = nada aplicável foi avaliado",
            "title": "Compliance Pct"
          },
          "failed": {
            "minimum": 0,
            "title": "Failed",
            "type": "integer"
          },
          "not_applicable": {
            "minimum": 0,
            "title": "Not Applicable",
            "type": "integer"
          },
          "not_assessed": {
            "minimum": 0,
            "title": "Not Assessed",
            "type": "integer"
          },
          "passed": {
            "minimum": 0,
            "title": "Passed",
            "type": "integer"
          }
        },
        "required": [
          "passed",
          "failed",
          "not_assessed",
          "not_applicable",
          "compliance_pct"
        ],
        "title": "Summary",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "assessment_id": {
        "description": "Sempre presente; para container é gerado na conclusão",
        "format": "uuid",
        "title": "Assessment Id",
        "type": "string"
      },
      "data": {
        "$ref": "#/$defs/AssessmentCompletedData"
      },
      "event_id": {
        "description": "Imutável: o mesmo em todas as retentativas (deduplique por ele)",
        "format": "uuid",
        "title": "Event Id",
        "type": "string"
      },
      "event_type": {
        "const": "assessment.completed",
        "title": "Event Type",
        "type": "string"
      },
      "installation_id": {
        "format": "uuid",
        "title": "Installation Id",
        "type": "string"
      },
      "occurred_at": {
        "description": "Quando a avaliação terminou",
        "format": "date-time",
        "title": "Occurred At",
        "type": "string"
      },
      "schema_version": {
        "const": 1,
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      }
    },
    "required": [
      "event_id",
      "event_type",
      "occurred_at",
      "installation_id",
      "assessment_id",
      "data"
    ],
    "title": "WebhookEvent",
    "type": "object"
  }
}
